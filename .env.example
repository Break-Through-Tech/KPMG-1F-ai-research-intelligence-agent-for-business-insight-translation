# Local-only BYOK generation. Retrieval/demo never require a key.
RESEARCH_PROVIDER=gemini
# Gemini preserves existing defaults; OpenAI/custom/Bedrock require RESEARCH_MODEL.
RESEARCH_MODEL=
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
# openai_compatible uses its own key, never another provider's key by fallback.
RESEARCH_API_KEY=
# Optional override: name of an environment variable, not the secret itself.
RESEARCH_API_KEY_ENV=
# Only for openai_compatible; HTTPS or loopback HTTP. No URL credentials/query.
RESEARCH_BASE_URL=
# Bedrock uses the AWS SDK credential chain, not RESEARCH_API_KEY.
# Set an explicit region and supply AWS_PROFILE, IAM credentials/role,
# or AWS_BEARER_TOKEN_BEDROCK privately. No credential values belong here.
AWS_REGION=

# Optional downstream business translation (validated: gemini-4-hydrogen only).
# Off unless enabled. Dedicated free-tier evaluation key; never a research key.
# Send only public research and non-confidential business context.
BUSINESS_TRANSLATION_ENABLED=
BUSINESS_TRANSLATION_API_KEY=
BUSINESS_TRANSLATION_API_KEY_ENV=
