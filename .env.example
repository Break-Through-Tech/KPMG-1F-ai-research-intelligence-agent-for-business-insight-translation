# Local-only BYOK generation. Retrieval/demo never require a key.
RESEARCH_PROVIDER=gemini
# Gemini preserves the existing defaults; OpenAI/custom require RESEARCH_MODEL.
RESEARCH_MODEL=
GOOGLE_MODEL=gemini-2.5-flash
GOOGLE_API_KEY=
OPENAI_API_KEY=
# openai_compatible uses its own key, never another provider's key by fallback.
RESEARCH_API_KEY=
# Optional override: name of an environment variable, not the secret itself.
RESEARCH_API_KEY_ENV=
# Only for openai_compatible; HTTPS or loopback HTTP. No URL credentials/query.
RESEARCH_BASE_URL=
