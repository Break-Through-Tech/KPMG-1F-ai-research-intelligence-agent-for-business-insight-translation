GOOGLE_API_KEY=
# Optional: select a Gemini model available to your account with Search grounding.
GOOGLE_MODEL=gemini-2.5-flash

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://<your-service>.search.windows.net
AZURE_SEARCH_INDEX_NAME=arxiv-papers
# Query-only access for retrieval teammates
AZURE_SEARCH_QUERY_KEY=
# Only required for explicit index writes/rebuilds
AZURE_SEARCH_ADMIN_KEY=
