# /etc/kpmg/preview.env (root:kpmg 0640). Edit with: sudoedit /etc/kpmg/preview.env
# then: sudo systemctl restart kpmg-preview

# fixture = synthetic hosting check; real = exact demo-100 from /var/lib/kpmg/assets/demo-100/
KPMG_DEPLOY_MODE=fixture
RESEARCH_ENGINE=baseline
S2_PAPER_BALANCE=0
# s2 = frozen S2 (default); r2 = optimized S2-R2 (opt-in; requires RESEARCH_ENGINE=s2 and S2_PAPER_BALANCE=0)
S2_RETRIEVAL=s2

# server.py hosted mode: HTTPS origin, mounted state disk. Caddy terminates HTTPS on
# 443 and forwards to port 8821, which the firewall keeps closed to the internet.
RENDER=true
PORT=8821
KPMG_ORIGIN=https://@DOMAIN@
KPMG_STATE_DIR=/var/lib/kpmg
KPMG_REVIEW_PASSWORD=@PASSWORD@

# Real mode only. Leave empty until the approved Gemini smoke test.
GOOGLE_API_KEY=
KPMG_GEMINI_DEDICATED_FREE=
